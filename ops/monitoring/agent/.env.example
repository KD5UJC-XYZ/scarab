# Copy to .env next to compose.yaml. .env is not committed.
# The name this worker's series and streams carry (label host).
SCARAB_HOST=worker-a
# The monitoring server (monitor-host's VPN address).
PROMETHEUS_PUSH_URL=http://<server-address>:9090/api/v1/write
LOKI_PUSH_URL=http://<server-address>:3100/loki/api/v1/push
# On Docker Desktop (worker-b): the network collectors cannot read the VM's /proc/net.
# UNIX_DISABLED_COLLECTORS=arp,netdev,netstat,softnet
# The directory the node exporter reads *.prom files from (the KES rotation driver of a pool writes one there with
# --metrics-file). Default ./textfile next to compose.yaml; create it before the first start.
# TEXTFILE_DIR=/srv/pool/metrics
