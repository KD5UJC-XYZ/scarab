    {
      "type": "timeseries",
      "title": "Sampled historical block number",
      "description": "Followed blocks, and the blocks a start replays from its own store.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (host, container) (max_over_time({host=~\"$host\", container=~\"$container\", event=\"extended\"} | json b=\"block.blockNo\" | unwrap b [$__auto]))",
          "legendFormat": "{{host}} {{container}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (host, container) (max_over_time({host=~\"$host\", container=~\"$container\", event=\"replayProgress\"} | json b=\"tip.blockNo\" | unwrap b [$__auto]))",
          "legendFormat": "replaying {{host}} {{container}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
