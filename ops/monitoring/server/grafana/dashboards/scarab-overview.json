          "expr": "max by (host, container) (cardano_node_metrics_peerSelection_Hot_int{host=~\"$host\", container=~\"$container\"}) + max by (host, container) (cardano_node_metrics_peerSelection_HotBigLedgerPeers_int{host=~\"$host\", container=~\"$container\"})",
          "legendFormat": "active {{host}} {{container}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, container) (scarab_peer_selection_targets{host=~\"$host\", container=~\"$container\", target=\"Active\"}) + max by (host, container) (scarab_peer_selection_targets{host=~\"$host\", container=~\"$container\", target=\"ActiveBigLedger\"})",
          "legendFormat": "target {{host}} {{container}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
