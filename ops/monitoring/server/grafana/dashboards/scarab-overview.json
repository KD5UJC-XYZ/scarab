    {
      "type": "timeseries",
      "title": "Hot peers and active target",
      "description": "Compare actual active peers with the sum of ordinary and big-ledger targets. Churn deliberately changes targets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
