# Copy to .env next to compose.yaml and fill in. .env is not committed.
# Address the three ports are published on: the host's VPN address on monitor-host, 127.0.0.1 for a local try.
BIND_ADDR=127.0.0.1
# Where Prometheus, Loki and Grafana keep their data (on monitor-host: /srv/scarab-monitoring/data).
DATA_DIR=./data
GRAFANA_ADMIN_USER=admin
PROMETHEUS_RETENTION=180d
# Required: Grafana's admin password (deploy.sh generates one on the server).
GRAFANA_ADMIN_PASSWORD=change-me
