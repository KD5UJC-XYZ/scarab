+
+  /** Opt-in preparation for detached native-script predicates. The existing transfer profile still
+    * rejects script credentials/witness fields; this does not admit script spending. Witness crypto
+    * is repeated to construct an unforgeable, exact-body-bound key set.
+    */
+  def compareWithVerifiedKeys(
+      context: ClusterTransfer.Context,
+      minimum: MinimumOutput.Parameters,
+      pre: Bytes,
+      post: Bytes,
+      original: Bytes,
+      blocks: Vector[Bytes]
+  ): Either[String, (Receipt, NativeScript.VerifiedKeys)] =
+    for
+      receipt <- compare(context, minimum, pre, post, original, blocks)
+      witnesses <- NativeScriptWitnesses.inspect(original)
+    yield (receipt, witnesses.verifiedKeys)
