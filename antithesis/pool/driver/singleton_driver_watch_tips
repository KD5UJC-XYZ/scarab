#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# The test template's one driver command; Antithesis runs it once per timeline, under faults. It reads every pool's
# tip CHECKS times at a fixed interval, records whether each extends its chain and whether all three agree, and
# exits 0, so that the command runs to completion.
set -uo pipefail
source /opt/at/lib.sh

assertion true true reachability Reachable "$STARTS" true

CHECKS=60
prev=$(tips)
for _ in $(seq "$CHECKS"); do
  sleep "$INTERVAL_SECONDS"
  now=$(tips)
  echo "watch: tips $now"
  extended=$(jq -cn --argjson p "$prev" --argjson c "$now" \
    '$c | with_entries(.value = ($p[.key] != null and .value != null and .value.block > $p[.key].block))')
  details=$(jq -cn --argjson p "$prev" --argjson c "$now" '{previous: $p, current: $c}')
  sometimes "$SCARAB_EXTENDS" "$(jq -r '.s1' <<< "$extended")" "$details"
  sometimes "$HASKELL_EXTENDS" "$(jq -r '.h2 or .h3' <<< "$extended")" "$details"
  sometimes "$ALL_EXTEND" "$(jq -r '[.[]] | all' <<< "$extended")" "$details"
  if agree "$now" 0; then together=true; else together=false; fi
  sometimes "$ALL_AGREE" "$together" "$details"
  if refused=$(refusal); then
    echo "watch: a Haskell pool refused a block: $refused"
    [ -n "${recorded[refused]:-}" ] || assertion true false reachability Unreachable "$HASKELL_REFUSED" false "$refused"
    recorded[refused]=1
  fi
  if refused=$(scarab_refusal); then
    echo "watch: s1 refused a block: $refused"
    [ -n "${recorded[scarab_refused]:-}" ] || assertion true false reachability Unreachable "$SCARAB_REFUSED" false "$refused"
    recorded[scarab_refused]=1
  fi
  prev=$now
done
