# Example settings for rotate_kes.py (systemd EnvironmentFile format; every name is ROTATE_KES_<flag>).
# All paths are placeholders.

# the directory the node container mounts: `current` (a relative link) -> gen-<counter>-<period>/{kes.skey,node.cert}
ROTATE_KES_KEY_DIR=/srv/pool/keys
# the cold key stays out of the key directory and is never mounted into the node: for a test network it may sit
# here, online; a mainnet pool keeps it offline and runs the same steps by hand up to `issue-op-cert`
ROTATE_KES_COLD_SKEY=/srv/pool/cold/cold.skey
ROTATE_KES_COLD_VKEY=/srv/pool/cold/cold.vkey
# the node's --local-socket, and the network
ROTATE_KES_SOCKET=/srv/pool/ipc/node.socket
ROTATE_KES_SHELLEY_GENESIS=/srv/pool/config/shelley-genesis.json
ROTATE_KES_TESTNET_MAGIC=42
# the node's container: signalled with SIGHUP, and its log read for the reload event
ROTATE_KES_CONTAINER=scarab-producer
# rotate when this many KES periods or fewer are left
ROTATE_KES_THRESHOLD=10

# a node_exporter textfile-collector file the driver rewrites after each run (see ops/monitoring/agent/.env.example: TEXTFILE_DIR)
ROTATE_KES_METRICS_FILE=/srv/pool/metrics/rotate_kes.prom
