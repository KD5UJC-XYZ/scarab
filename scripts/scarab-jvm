#!/bin/bash -p
# SPDX-License-Identifier: Apache-2.0
# Starts the node's JVM so that its memory, and a forging node's keys in it, stay off disk (docs/running/forging.md,
# "Keys in memory"). The release image's entry point and the Nix network apps (scripts/nix-network) run it as
# `scarab-jvm <absolute path of java> <java arguments>`, and it ends in `exec <java> <its options> <java arguments>`,
# so the JVM keeps this process and its signals. Its arguments are trusted: they come after its options and can
# override them. Privileged mode (-p) reads no BASH_ENV or ENV file and imports no function from the environment, so
# nothing runs before these lines and no function stands in for a builtin; a caller that names bash names -p too.
set -euo pipefail

say() {
  printf 'scarab-jvm: %s\n' "$*" >&2
}
refuse() {
  say "$*"
  exit 2
}

[[ ${1-} == /* ]] || refuse "the first argument must be the absolute path of java"
java=$1
shift

sizing=()
if [[ -v SCARAB_HEAP_SIZE ]]; then
  [[ $SCARAB_HEAP_SIZE =~ ^[1-9][0-9]*[kKmMgG]?$ ]] ||
    refuse "SCARAB_HEAP_SIZE must be a heap size such as 3g or 3072m"
  sizing+=("-Xmx$SCARAB_HEAP_SIZE")
fi
if [[ -v SCARAB_RUN_PROCESSORS ]]; then
  [[ $SCARAB_RUN_PROCESSORS =~ ^[1-9][0-9]*$ ]] || refuse "SCARAB_RUN_PROCESSORS must be a whole number of processors"
  sizing+=("-XX:ActiveProcessorCount=$SCARAB_RUN_PROCESSORS")
fi

case ${SCARAB_JVM_DIAGNOSTICS-} in
  '' | 0)
    # The JVM reads the first three before and after its command line, and options in them (OnError, HeapDumpPath, a
    # recording at start, ...) would write memory however the options below are set; JDK_ALTERNATE_VM names the
    # libjvm.so the launcher loads.
    dropped=()
    for name in JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS _JAVA_OPTIONS JDK_ALTERNATE_VM; do
      if [[ -v $name ]]; then
        dropped+=("$name")
        unset "$name"
      fi
    done
    if ((${#dropped[@]})); then
      say "dropped ${dropped[*]} from the JVM's environment; SCARAB_JVM_DIAGNOSTICS=1 keeps them (never on a forging node)"
    fi
    # Soft and hard: a core file from any signal, also SIGABRT, which the JVM does not catch.
    ulimit -c 0
    memory=(-XX:-CreateCoredumpOnCrash -XX:ErrorFile=/dev/null -XX:-ErrorFileToStdout -XX:-ErrorFileToStderr
      -XX:-DumpReplayDataOnError -XX:-HeapDumpOnOutOfMemoryError -XX:+DisableAttachMechanism -XX:+PerfDisableSharedMem)
    ;;
  1)
    say "memory diagnostics enabled: do not use on a forging node (core files, crash reports, heap dumps and attach" \
      "are the JVM's defaults, with JAVA_TOOL_OPTIONS, JDK_JAVA_OPTIONS, _JAVA_OPTIONS and JDK_ALTERNATE_VM as given)"
    memory=()
    ;;
  *)
    refuse "SCARAB_JVM_DIAGNOSTICS must be 1, 0 or unset"
    ;;
esac

# In either mode: on JDK 25, C2 miscompiled code of the ledger rules (a null `Collateral.fee`, so a NullPointerException
# on a phase-2-invalid transaction, #1521) until its reduction of allocation merges was turned off. The one list is
# scripts/jit_workaround.py, which scripts/check_jit_workaround.py holds this copy to. The arguments come after it, so
# they can override it.
jit=(-XX:+UnlockDiagnosticVMOptions -XX:-ReduceAllocationMerges)

exec "$java" "${sizing[@]}" "${memory[@]}" "${jit[@]}" "$@"
