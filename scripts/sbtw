#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."
version=1.10.7
sha=3cca02818047327a83efde776103a1ef92f76f72c062badbbb062499a3270c07
base="${SCARAB_CACHE_DIR:-${LAB_CACHE_DIR:-$PWD/.cache}}"
cache="$base/scarab"
# The cache was `.cache/cardano-scala-lab` before the rename: move it once and leave a symlink, so classpath
# files and long-running containers that name the old path keep working. (Both layouts are handled.)
if [ ! -e "$cache" ] && [ -d "$base/cardano-scala-lab" ] && [ ! -L "$base/cardano-scala-lab" ]; then
  mv "$base/cardano-scala-lab" "$cache"
  ln -s scarab "$base/cardano-scala-lab"
fi
mkdir -p "$cache"
jar="$cache/sbt-launch-$version.jar"
if [ ! -f "$jar" ]; then
  curl --fail --location --proto '=https' "https://repo.maven.apache.org/maven2/org/scala-sbt/sbt-launch/$version/sbt-launch-$version.jar" -o "$jar"
fi
printf '%s  %s\n' "$sha" "$jar" | sha256sum --check --status
export XDG_RUNTIME_DIR="$cache/run"
mkdir -p "$XDG_RUNTIME_DIR"
export COURSIER_CACHE="$cache/coursier"
processors="${SCARAB_BUILD_PROCESSORS:-4}"
repositories=project/repositories
# The small standalone version-contract fixture has no Scalus dependency or patch manifest.
# A real build also requires this repository in build.sbt and cannot fall back to upstream 1.4.0.
if [ -f patches/scalus/manifest.json ]; then
  scalus_options=()
  if [ "${SCARAB_OFFLINE:-0}" = 1 ]; then scalus_options+=(--offline); fi
  repositories=$(python3 scripts/prepare_scalus.py --cache "$cache" --launcher "$jar" \
    --processors "$processors" "${scalus_options[@]}")
fi
exec java -Dsbt.server.autostart=false -Dsbt.server.forcestart=true -Dsbt.boot.directory="$cache/boot" -Dsbt.global.base="${SBT_GLOBAL_BASE:-$cache/global}" -Dsbt.ivy.home="$cache/ivy" -XX:ActiveProcessorCount="$processors" -Xms256m -Xmx2g -Dsbt.override.build.repos=true -Dsbt.repository.config="$repositories" -Dsbt.supershell=false -jar "$jar" "$@"
