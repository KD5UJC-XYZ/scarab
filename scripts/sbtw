#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
cd "$(dirname "$0")/.."
version=1.10.7
sha=3cca02818047327a83efde776103a1ef92f76f72c062badbbb062499a3270c07
base="${SCARAB_CACHE_DIR:-${LAB_CACHE_DIR:-$PWD/.cache}}"
cache="$base/scarab"
# The cache was `.cache/cardano-scala-lab` before the rename: move it once and leave a symlink, so classpath
# files and long-running containers that name the old path keep working. (Both layouts are handled.)
if [ ! -e "$cache" ] && [ -d "$base/cardano-scala-lab" ] && [ ! -L "$base/cardano-scala-lab" ]; then
  mv "$base/cardano-scala-lab" "$cache"
  ln -s scarab "$base/cardano-scala-lab"
fi
mkdir -p "$cache"
jar="$cache/sbt-launch-$version.jar"
if [ ! -f "$jar" ]; then
  curl --fail --location --proto '=https' "https://repo.maven.apache.org/maven2/org/scala-sbt/sbt-launch/$version/sbt-launch-$version.jar" -o "$jar"
fi
printf '%s  %s\n' "$sha" "$jar" | sha256sum --check --status
# sbt has two sockets, each named from a hash of the build's path: the boot socket under XDG_RUNTIME_DIR, and the
# command server's under SBT_GLOBAL_SERVER_DIR (by default under the global base, which may be the shared cache).
# Containers mount their checkouts at one path and share the cache, so sockets there were shared, and a client could
# reach another container's server (#1094). Both go in the machine's own temporary directory instead: private to a
# container, and shared by the commands run in it. A Unix socket's path holds at most 107 bytes, and the longer of
# sbt's two adds 50 bytes to this directory (`/.sbt/sbt-socket<hash>/sbt-load.sock`, a signed 64-bit hash).
runtime="${TMPDIR:-/tmp}/scarab-sbt-$(id -u)"
if [ "$(printf %s "$runtime" | wc -c)" -gt 57 ]; then
  echo "sbtw: $runtime is longer than 57 bytes, too long for sbt's socket paths; set TMPDIR to a shorter directory" >&2
  exit 1
fi
mkdir -p "$runtime"
if [ -L "$runtime" ] || [ ! -O "$runtime" ]; then
  echo "sbtw: $runtime is a symbolic link or belongs to another user; sbt's sockets need a directory of this user's" >&2
  exit 1
fi
chmod 700 "$runtime"
export XDG_RUNTIME_DIR="$runtime" SBT_GLOBAL_SERVER_DIR="$runtime/server"
export COURSIER_CACHE="$cache/coursier"
processors="${SCARAB_BUILD_PROCESSORS:-4}"
repositories=project/repositories
# -Xss is the compiler's thread stack: an incremental recompile of node's Main.scala overflows the
# 1 MiB default in PostTyper. Forked test JVMs take their own javaOptions, and the stack-safety
# suites pin explicit small-stack threads, so this does not reach them.
# JDK 25 warns where a restricted method is called and where `sun.misc.Unsafe`'s memory methods are used (issue
# 589): the in-process tests load blst's JNI library, and Scala's lazy vals and Zinc's hashing call `Unsafe`.
# Allowing both keeps `check` and the build's own log free of the warning, and stops a later JDK from blocking
# the call. A forked test group takes its options from build.sbt instead.
jvm_options=(--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow)
exec java "${jvm_options[@]}" -Dsbt.server.autostart=false -Dsbt.server.forcestart=true -Dsbt.boot.directory="$cache/boot" -Dsbt.global.base="${SBT_GLOBAL_BASE:-$cache/global}" -Dsbt.ivy.home="$cache/ivy" -XX:ActiveProcessorCount="$processors" -Xms256m -Xmx2g -Xss8m -Dsbt.override.build.repos=true -Dsbt.repository.config="$repositories" -Dsbt.supershell=false -jar "$jar" "$@"
