-- SPDX-License-Identifier: Apache-2.0
-- The ledger and cardano-base revisions, and the index state, of cardano-node b004fe0c
-- (branch leios-prototype), the build of the public Leios testnet's release rc-2026w44: the
-- repository, index-state and source-repository-package stanzas below are copied from that
-- commit's cabal.project.
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

index-state:
  , hackage.haskell.org 2026-09-02T14:05:07Z
  , cardano-haskell-packages 2026-10-09T14:30:01Z

packages: harness
write-ghc-environment-files: never
tests: false
benchmarks: false
optimization: 0

package plutus-core
  flags: -with-inline-r -with-cert +with-crypto
package bitvec
  flags: -simd

-- cardano-base master past PR #695: proofs of possession use the IETF BLS_POP_ DST
-- and the BLS DSTs take no signing context. Unreleased; CHaP's cardano-crypto-class
-- 2.6.0.0 still makes proofs under BLS_SIG_.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-base
  tag: c1e1ed8d7ae39c111c73fc5f59ac37ce5933b83c
  --sha256: sha256-UawlVBgCkU8H6o1k8BHj6pRkZjbHsdVEVIBW0ZFpWkc=
  subdir:
    cardano-binary
    cardano-crypto-class
    cardano-crypto-leios
    cardano-crypto-praos

-- cardano-ledger leios-prototype with cardano-ledger master (07d904eb2c) merged
-- (ch1bo/leios-prototype-2026w42).
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-ledger
  tag: 9df9f98cce86c5f2195142b2c02dd9b39dd9dc7c
  --sha256: sha256-di4fCxtSHMOPWIbAd5I5GI1uu+hwReAzTWEFuSwZl2E=
  subdir:
    libs/cardano-data
    libs/cardano-ledger-api
    libs/small-steps
    libs/cardano-ledger-binary
    libs/cardano-ledger-core
    libs/cardano-protocol
    libs/cardano-protocol-tpraos
    eras/byron/chain/executable-spec
    eras/byron/ledger/executable-spec
    eras/shelley/impl
    eras/shelley/test-suite
    eras/shelley-ma/test-suite
    eras/mary/impl
    eras/allegra/impl
    eras/alonzo/impl
    eras/alonzo/test-suite
    eras/babbage/impl
    eras/conway/impl
    eras/dijkstra/impl

-- The same cardano-node b004fe0c project pins its protocol implementation and network.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/ouroboros-consensus
  tag: 2416493bfdbe93b761b3a4bb1ccf2b4a913e5e4b

source-repository-package
  type: git
  location: https://github.com/IntersectMBO/ouroboros-network
  tag: 2f1c154f248659b89523d5679ca532f442e7ed2a
  subdir:
    ouroboros-network
    cardano-diffusion
