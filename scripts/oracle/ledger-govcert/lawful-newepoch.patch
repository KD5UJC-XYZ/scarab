+-- Supplemental lawful no-action generator. Construct the native pending enactment
+-- from the same governance state; do not repair/filter the original trueSpec input.
+-- No reward update, no pools or proposals: snapshot/pool defaults use native
+-- nonzero sentinels. Same/next/skipped epoch signals cover all guard branches.
+genLawfulNewEpoch :: Word64 -> Gen ((), TRC (EraRule "NEWEPOCH" ConwayEra))
+genLawfulNewEpoch advance = do
+  params <- resize 10 (genFromSpec (pparamsSpec @ConwayEra))
+  epoch <- (`mod` 50001) <$> arbitrary
+  let gov0 = def & cgsCurPParamsL .~ params & cgsPrevPParamsL .~ params
+      ratify = def & rsEnactStateL .~ mkEnactState gov0
+      gov = gov0 & cgsDRepPulsingStateL .~ DRComplete def ratify
+      st = def & esLStateL . lsUTxOStateL . utxosGovStateL .~ gov
+      nes = def & nesELL .~ EpochNo epoch & nesEsL .~ st & nesRuL .~ SNothing
+  pure ((), TRC ((), nes, EpochNo (epoch + advance)))
