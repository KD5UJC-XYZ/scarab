@@ -71,7 +71,7 @@ import Test.Cardano.Ledger.Shelley.ImpTest (
   logDoc,
   tryRunImpRule,
  )
-import UnliftIO (evaluateDeep)
+import UnliftIO (evaluateDeep, liftIO)
 import UnliftIO.Directory (makeAbsolute)
 import UnliftIO.Environment (lookupEnv)
 
@@ -299,6 +299,25 @@ testConformance ::
   Property
 testConformance ctx trc = property $ do
   ConformanceResult implResTest agdaResTest implRes <- runConformance @rule @era ctx trc
+  -- Optional observer used by Scarab's disposable pinned-source adapter. It records the
+  -- generated upstream input and the implementation result after the ordinary conformance
+  -- computation; it does not change generation, translation, execution, or checking.
+  exportDir <- liftIO $ lookupEnv "SCARAB_CONFORMANCE_EXPORT_DIR"
+  case exportDir of
+    Nothing -> pure ()
+    Just path -> do
+      let TRC (env, st, sig) = trc
+      dumpCbor @era path ctx "context"
+      dumpCbor @era path env "environment"
+      dumpCbor @era path st "state"
+      dumpCbor @era path sig "signal"
+      implStatus <- case implRes of
+        Right (implState, _) -> do
+          dumpCbor @era path implState "implementation-state"
+          pure "implementation-accepted"
+        Left _ -> pure "implementation-rejected"
+      let agdaStatus = either (const "agda-rejected") (const "agda-accepted") agdaResTest
+      liftIO $ writeFile (path <> "/result.txt") (implStatus <> "\n" <> agdaStatus <> "\n")
   globals <- use impGlobalsL
   logDoc $ extraInfo @rule @era globals ctx trc (first (T.pack . show) implRes)
   checkConformance @rule @_ ctx trc (first (T.pack . show) implResTest) agdaResTest
