+
+-- Supplemental native judgments from the original clean payment input. The
+-- original LEDGER hook remains intact; these are separately typed rule calls.
+scarabSubmitHook ::
+  Globals ->
+  TRC (EraRule "LEDGER" ConwayEra) ->
+  Either
+    (NonEmpty (PredicateFailure (EraRule "LEDGER" ConwayEra)))
+    (State (EraRule "LEDGER" ConwayEra), [Event (EraRule "LEDGER" ConwayEra)]) ->
+  ImpM t ()
+scarabSubmitHook globals trc@(TRC (env, st, sig)) result = do
+  submitTxConformanceHook globals trc result
+  let tx = sig ^. txStAnnTxG
+      body = tx ^. bodyTxL
+  when (null (body ^. certsTxBodyL) && null (body ^. proposalProceduresTxBodyL)) $ do
+    let ctx = mkRuleExecContext @"LEDGER" @ConwayEra globals trc
+        utxoCtx = clecUtxoExecContext ctx
+        utxoEnv = uecUtxoEnv utxoCtx
+        utxoState = lsUTxOState st
+    let utxoResult = runSTS @"UTXO" @ConwayEra globals utxoEnv utxoState sig
+    conformanceHook @"UTXO" @ConwayEra globals
+      (TRC (utxoEnv, utxoState, sig)) utxoCtx utxoResult
+    let utxowResult = runSTS @"UTXOW" @ConwayEra globals utxoEnv utxoState sig
+    conformanceHook @"UTXOW" @ConwayEra globals
+      (TRC (utxoEnv, utxoState, sig)) utxoCtx utxowResult
+    case Shelley.ledgerEpochNo env of
+      Nothing -> pure ()
+      Just epoch -> do
+        let batchEnv = Shelley.LedgersEnv
+              (Shelley.ledgerSlotNo env) epoch (Shelley.ledgerPp env) (Shelley.ledgerAccount env)
+            signal = Seq.singleton tx
+        let batchResult = runSTS @"LEDGERS" @ConwayEra globals batchEnv st signal
+        conformanceHook @"LEDGERS" @ConwayEra globals
+          (TRC (batchEnv, st, signal)) (clecEnactState ctx) batchResult
