+observeRatify :: TRC (EraRule "RATIFY" ConwayEra) -> ConformanceResult "RATIFY" ConwayEra -> ImpTestM ConwayEra ()
+observeRatify (TRC (ratEnv, ratSt, ratSig@(RatifySignal actions))) res = do
+  exportDir <- liftIO $ lookupEnv "SCARAB_GOVERNANCE_EXPORT_DIR"
+  case exportDir of
+    Nothing -> pure ()
+    Just path -> do
+      dumpCbor @ConwayEra path () "context"
+      dumpCbor @ConwayEra path ratEnv "environment"
+      dumpCbor @ConwayEra path ratSt "state"
+      dumpCbor @ConwayEra path (ratSig) "signal"
+      dumpCbor @ConwayEra path (concatMap (\gas -> [Conway.dRepAccepted ratEnv ratSt gas, Conway.spoAccepted ratEnv ratSt gas]) (toList actions)) "approvals"
+      case crImplementationResult res of
+        Right (out, _) -> dumpCbor @ConwayEra path out "implementation-state"
+        Left failure -> liftIO $ writeFile (path <> "/native-failure.txt") (show failure)
+      liftIO $ writeFile (path <> "/result.txt") $ unlines
+        [ either (const "implementation-rejected") (const "implementation-accepted") (crImplementationResult res)
+        , either (const "agda-rejected") (const "agda-accepted") (crSpecificationResult res)
+        , case (crTranslationResult res, crSpecificationResult res) of
+          (Right native, Right formal) | native == formal -> "outputs-equal"
+          _ -> "outputs-differ"
+        ]
+
 spec :: Spec
 spec = withImpInit @(LedgerSpec ConwayEra) $ describe "RATIFY" $ modifyImpInitProtVer (eraProtVerHigh @ConwayEra) $ do
   it "NoConfidence accepted conforms" $ do
