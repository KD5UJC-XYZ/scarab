+        (runReader (epochFromSlot $ Shelley.ledgerSlotNo env) testGlobals) (Shelley.ledgerPp env) (Shelley.ledgerAccount env)
+  pure (clecEnactState ctx, TRC (batchEnv, state, Seq.singleton (sig ^. txStAnnTxG)))
