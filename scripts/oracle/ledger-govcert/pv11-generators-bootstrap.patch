+-- Construct cached stake and the deposit pot from the same native UTxO/cert state.
+-- The original generator leaves these fields unrelated to the UTxO; keep its raw
+-- observations separately rather than treating invalid cache underflow as parity.
+coherentUtxo :: (UtxoExecContext ConwayEra, TRC (EraRule "UTXO" ConwayEra)) -> (UtxoExecContext ConwayEra, TRC (EraRule "UTXO" ConwayEra))
+coherentUtxo (ctx, TRC (env, state, sig)) =
+  let pp = Shelley.uePParams env
+      gov = utxosGovState state & cgsCurPParamsL .~ pp
+      lawful = smartUTxOState pp (utxosUtxo state)
+        (totalObligation (Shelley.ueCertState env) gov) (utxosFees state) gov (utxosDonation state)
+  in (ctx, TRC (env, lawful, sig))
+
+freshUtxow :: Gen (UtxoExecContext ConwayEra, TRC (EraRule "UTXOW" ConwayEra))
+freshUtxow = do
+  (ctx, TRC triple) <- freshUtxo
