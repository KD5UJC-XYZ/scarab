+
+freshLedger :: Gen (ConwayLedgerExecContext ConwayEra, TRC (EraRule "LEDGER" ConwayEra))
+freshLedger = do
+  (_, TRC (env, state, sig)) <- freshUtxo
+  let params = Shelley.uePParams env
+      epoch = runReader (epochFromSlot $ Shelley.ueSlot env) testGlobals
+      -- The original UTXO generator does not constrain governance parameters.
+      -- A LEDGER context must use the same parameters as the supplied environment.
+      state' = state & utxosGovStateL . cgsCurPParamsL .~ params
+        & utxosDepositedL .~ totalObligation (Shelley.ueCertState env) (utxosGovState state)
+      ledgerState = LedgerState state' (Shelley.ueCertState env)
+      ledgerEnv = Shelley.LedgerEnv (Shelley.ueSlot env) (Just epoch) minBound params def
+      trc = TRC (ledgerEnv, ledgerState, sig)
+  pure (mkRuleExecContext @"LEDGER" @ConwayEra testGlobals trc, trc)
