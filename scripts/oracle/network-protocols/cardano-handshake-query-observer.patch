+-- | Export the unchanged seeded NodeToNode query-version property inputs.
+-- The client map is retained before and after the exact query transform used
+-- by prop_query_version_NodeToNode_ST; the server map is retained unchanged.
+exportCardanoQueryVersionCases :: IO ()
+exportCardanoQueryVersionCases = do
+    maybePath <- lookupEnv "SCARAB_HANDSHAKE_QUERY_CASES"
+    case maybePath of
+      Nothing -> pure ()
+      Just path -> withFile path WriteMode $ \out ->
+        forM_ [0 .. 63 :: Int] $ \ordinal -> do
+          let seed = 498101 + ordinal
+              size = 60 + ordinal `mod` 31
+              generated = unGen
+                ((,) <$> arbitrary <*> arbitrary)
+                (mkQCGen seed) size
+                :: (ArbitraryNodeToNodeVersions, ArbitraryNodeToNodeVersions)
+              (ArbitraryNodeToNodeVersions clientVersions,
+               ArbitraryNodeToNodeVersions serverVersions) = generated
+              clientQueryVersions = updateVersionData
+                (\vd -> vd { NTN.query = True, NTN.peerSharing = PeerSharingEnabled })
+                clientVersions
+              property = prop_query_version_NodeToNode_ST
+                (ArbitraryNodeToNodeVersions clientVersions)
+                (ArbitraryNodeToNodeVersions serverVersions)
+              VersionDataCodec { encodeData } = NTN.nodeToNodeVersionDataCodec
+              proposal tag versions = CBOR.TList
+                [ CBOR.TInt tag
+                , CBOR.TMap
+                    [ (CBOR.TInt (fromIntegral (fromEnum version + 14)), encodeData version (versionData entry))
+                    | (version, entry) <- Map.toAscList (getVersions versions)
+                    ]
+                ]
+              wire tag versions = hexLazy $ CBOR.toLazyByteString (CBOR.encodeTerm (proposal tag versions))
+          result <- quickCheckWithResult
+            stdArgs { chatty = False, replay = Just (mkQCGen (seed + 900001), size) }
+            (once property)
+          let rows = ["cardano-handshake-query-v1", show seed, show ordinal, show size
+                     , if isSuccess result then "pass" else "upstream-failure"]
+                     ++ [wire 0 clientVersions, wire 0 clientQueryVersions, wire 0 serverVersions]
+          hPutStrLn out (intercalate "\t" rows)
+          unless (isSuccess result) $
+            fail ("Cardano Handshake query-version property failed at seed " ++ show seed)
+  where
+    hexLazy = concatMap hexByte . BL.unpack
+    hexByte :: Word8 -> String
+    hexByte w = let h = showHex w "" in if length h == 1 then '0' : h else h
+
+
+-- | Export a separately labelled correlated slice: one unchanged generated
+-- version map is supplied to both arguments of the original query ST property.
+-- Empty maps are recorded as precondition-filtered; generated fields are never rewritten.
+exportCardanoCorrelatedQueryCases :: IO ()
+exportCardanoCorrelatedQueryCases = do
+    maybePath <- lookupEnv "SCARAB_HANDSHAKE_QUERY_CORRELATED_CASES"
+    case maybePath of
+      Nothing -> pure ()
+      Just path -> withFile path WriteMode $ \out ->
+        forM_ [0 .. 63 :: Int] $ \ordinal -> do
+          let seed = 499001 + ordinal
+              size = 60 + ordinal `mod` 31
+              generated = unGen arbitrary (mkQCGen seed) size
+                :: ArbitraryNodeToNodeVersions
+              ArbitraryNodeToNodeVersions versions = generated
+              clientQueryVersions = updateVersionData
+                (\vd -> vd { NTN.query = True, NTN.peerSharing = PeerSharingEnabled })
+                versions
+              VersionDataCodec { encodeData } = NTN.nodeToNodeVersionDataCodec
+              queryTerm tag offers = CBOR.TList
+                [ CBOR.TInt tag
+                , CBOR.TMap
+                    [ (CBOR.TInt (fromIntegral (fromEnum version + 14)), encodeData version (versionData entry))
+                    | (version, entry) <- Map.toAscList (getVersions offers)
+                    ]
+                ]
+              wire tag offers = hexLazy $ CBOR.toLazyByteString (CBOR.encodeTerm (queryTerm tag offers))
+              wires = [wire 0 versions, wire 0 clientQueryVersions, wire 3 versions]
+          if Map.null (getVersions versions)
+            then hPutStrLn out $ intercalate "\t"
+              (["cardano-handshake-query-correlated-v1", show seed, show ordinal, show size, "empty-version-map"] ++ wires)
+            else do
+              result <- quickCheckWithResult
+                stdArgs { chatty = False, replay = Just (mkQCGen (seed + 900002), size) }
+                (once (prop_query_version_NodeToNode_ST generated generated))
+              hPutStrLn out $ intercalate "\t"
+                (["cardano-handshake-query-correlated-v1", show seed, show ordinal, show size
+                 , if isSuccess result then "pass" else "upstream-failure"] ++ wires)
+              unless (isSuccess result) $
+                fail ("Cardano correlated Handshake query-version property failed at seed " ++ show seed)
+  where
+    hexLazy = concatMap hexByte . BL.unpack
+    hexByte :: Word8 -> String
+    hexByte w = let h = showHex w "" in if length h == 1 then '0' : h else h
