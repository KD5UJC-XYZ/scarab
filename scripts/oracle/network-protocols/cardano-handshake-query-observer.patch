+-- | Export unchanged generated maps and the original simultaneous-open ST property result.
+-- Both maps are sent as their exact original proposal CBOR; application results come from
+-- the property's pureHandshake oracle and remain outside the wire data.
+exportCardanoSimultaneousOpenCases :: IO ()
+exportCardanoSimultaneousOpenCases = do
+    maybePath <- lookupEnv "SCARAB_HANDSHAKE_SIMOPEN_CASES"
+    case maybePath of
+      Nothing -> pure ()
+      Just path -> withFile path WriteMode $ \out ->
+        forM_ [0 .. 63 :: Int] $ \ordinal -> do
+          let seed = 502001 + ordinal
+              size = 60 + ordinal `mod` 31
+              generated = unGen
+                ((,) <$> arbitrary <*> arbitrary)
+                (mkQCGen seed) size
+                :: (ArbitraryNodeToNodeVersions, ArbitraryNodeToNodeVersions)
+              (ArbitraryNodeToNodeVersions clientVersions,
+               ArbitraryNodeToNodeVersions serverVersions) = generated
+              property = prop_channel_simultaneous_open_NodeToNode_ST
+                (ArbitraryNodeToNodeVersions clientVersions)
+                (ArbitraryNodeToNodeVersions serverVersions)
+              (serverResult, clientResult) = pureHandshake
+                ((maybeAccept .) . acceptableVersion)
+                serverVersions
+                clientVersions
+              renderResult = maybe "none" (\value -> if value then "true" else "false")
+              VersionDataCodec { encodeData } = NTN.nodeToNodeVersionDataCodec
+              proposal versions = CBOR.TList
+                [ CBOR.TInt 0
+                , CBOR.TMap
+                    [ (CBOR.TInt (fromIntegral (fromEnum version + 14)), encodeData version (versionData entry))
+                    | (version, entry) <- Map.toAscList (getVersions versions)
+                    ]
+                ]
+              wire versions = hexLazy $ CBOR.toLazyByteString (CBOR.encodeTerm (proposal versions))
+          result <- quickCheckWithResult
+            stdArgs { chatty = False, replay = Just (mkQCGen (seed + 900005), size) }
+            (once property)
+          hPutStrLn out $ intercalate "\t"
+            [ "cardano-handshake-simopen-v1", show seed, show ordinal, show size
+            , if isSuccess result then "pass" else "upstream-failure"
+            , renderResult clientResult, renderResult serverResult
+            , wire clientVersions, wire serverVersions
+            ]
+          unless (isSuccess result) $
+            fail ("Cardano Handshake simultaneous-open property failed at seed " ++ show seed)
+  where
+    hexLazy = concatMap hexByte . BL.unpack
+    hexByte :: Word8 -> String
+    hexByte w = let h = showHex w "" in if length h == 1 then '0' : h else h
