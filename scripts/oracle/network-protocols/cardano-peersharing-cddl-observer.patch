+exportPeerSharingCase :: Int -> BL.ByteString -> BL.ByteString -> String -> IO ()
+exportPeerSharingCase ordinal diagnostic encoded outcome = do
+    maybePath <- lookupEnv "SCARAB_CDDL_EXPORT"
+    maybeVersion <- lookupEnv "SCARAB_CDDL_VERSION"
+    case (maybePath, maybeVersion) of
+      (Just path, Just version) -> appendFile path $ intercalate "\t"
+        [ "cardano-peersharing-sockaddr-cddl-v1", version, show ordinal
+        , outcome, hexLazy diagnostic, hexLazy encoded
+        ] ++ "\n"
+      _ -> pure ()
+  where
+    hexLazy = concatMap hexByte . BL.unpack
+    hexByte w = let h = showHex (fromIntegral w :: Int) "" in if length h == 1 then '0' : h else h
 
