+unit_decodePeerSharingV14ToLast spec = do
+    forM_ [NodeToNodeV_14 ..] $ \v -> do
+      setEnv "SCARAB_CDDL_VERSION" (show $ nodeToNodeVersionNumber v)
+      validateDecoder Nothing
+        spec (codecPeerSharing v)
+        [ SomeAgency PeerSharing.SingIdle
+        , SomeAgency PeerSharing.SingBusy
+        ]
+        100
+    replayScarabPeerSharing
+
+nodeToNodeVersionNumber :: NodeToNodeVersion -> Int
+nodeToNodeVersionNumber NodeToNodeV_14 = 14
+nodeToNodeVersionNumber NodeToNodeV_15 = 15
+nodeToNodeVersionNumber NodeToNodeV_16 = 16
+
+replayScarabPeerSharing :: Assertion
+replayScarabPeerSharing = do
+    maybePath <- lookupEnv "SCARAB_PEERSHARING_REPLAY"
+    case maybePath of
+      Nothing -> pure ()
+      Just path -> do
+        rows <- lines <$> readFile path
+        forM_ rows $ \row -> case splitTabs row of
+          [versionText, ordinalText, originalHex, scarabHex] -> do
+            let version = read versionText :: Int
+                ordinal = read ordinalText :: Int
+                ntnVersion = case version of
+                  14 -> NodeToNodeV_14
+                  15 -> NodeToNodeV_15
+                  16 -> NodeToNodeV_16
+                  _  -> error $ "unexpected PeerSharing replay version " ++ show version
+                codec = codecPeerSharing ntnVersion
+                agencies =
+                  [ SomeAgency PeerSharing.SingIdle
+                  , SomeAgency PeerSharing.SingBusy
+                  ]
+            original <- decodePeerSharingShow codec agencies (decodeHex originalHex)
+            scarab <- decodePeerSharingShow codec agencies (decodeHex scarabHex)
+            case (original, scarab) of
+              (Just originalMessage, Just scarabMessage) ->
+                assertEqual ("Haskell typed message v" ++ show version ++ "/" ++ show ordinal)
+                  originalMessage scarabMessage
+              _ -> assertFailure $ "upstream decoder rejected original or Scarab wire at v"
+                                ++ show version ++ "/" ++ show ordinal
+          _ -> assertFailure "malformed Scarab PeerSharing replay row"
+  where
+    splitTabs [] = [""]
+    splitTabs input = case break (== '\t') input of
+      (field, []) -> [field]
+      (field, _:rest) -> field : splitTabs rest
+    decodeHex [] = BL.empty
+    decodeHex (a:b:rest) = case readHex [a,b] of
+      [(value, "")] -> fromIntegral (value :: Int) `BL.cons` decodeHex rest
+      _ -> error "invalid hex in Scarab PeerSharing replay"
+    decodeHex _ = error "odd-length hex in Scarab PeerSharing replay"
+
+decodePeerSharingShow
+    :: Codec (PeerSharing.PeerSharing SockAddr) CBOR.DeserialiseFailure IO BL.ByteString
+    -> [SomeAgency (PeerSharing.PeerSharing SockAddr)]
+    -> BL.ByteString
+    -> IO (Maybe String)
+decodePeerSharingShow _ [] _ = pure Nothing
+decodePeerSharingShow codec (SomeAgency (stok :: StateToken st) : rest) bytes = do
+    decoder <- (decode codec stok :: IO
+      (DecodeStep BL.ByteString CBOR.DeserialiseFailure IO (SomeMessage st)))
+    result <- runDecoder [bytes] decoder
+    case result of
+      Right (SomeMessage message) -> pure (Just (show message))
+      Left _ -> decodePeerSharingShow codec rest bytes
 
