+-- Observation only: same original generator, ordinary (inline payload) codec and
+-- unmodified properties. Separately serialised fields retain the original values.
+exportOrdinaryCases :: FilePath -> Int -> Int -> IO ()
+exportOrdinaryCases path count seed = withFile path WriteMode $ \out ->
+  forM_ [0 .. count - 1] $ \ordinal -> do
+    let caseSeed = seed + ordinal
+        caseSize = 8 + ordinal `mod` 9
+        input = unGen arbitrary (mkQCGen caseSeed) caseSize
+          :: AnyMessage (BlockFetch Block (Point Block))
+    verdicts <- sequence
+      [ quickCheckWithResult
+          stdArgs { chatty = False, replay = Just (mkQCGen (caseSeed + offset), caseSize) }
+          (once (originalProperty input))
+      | (offset, originalProperty) <- zip [1000003, 2000003, 3000003, 4000003, 5000003]
+          [prop_codec_BlockFetch, prop_codec_splits2_BlockFetch, prop_codec_splits3_BlockFetch, prop_codec_cbor_BlockFetch, prop_codec_valid_cbor_BlockFetch]
+      ]
+    case input of
+      AnyMessage (msg :: Message (BlockFetch Block (Point Block)) st st') -> do
+        let ordinary = codec :: Codec (BlockFetch Block (Point Block)) S.DeserialiseFailure IO ByteString
+            token = stateToken :: StateToken st
+            (state, sender) = case token of
+              SingBFIdle -> ("idle", "client")
+              SingBFBusy -> ("busy", "server")
+              SingBFStreaming -> ("streaming", "server")
+              SingBFDone -> ("done", "client")
+            (tag, fields) = case msg of
+              MsgRequestRange (ChainRange from to) -> ("request-range", [S.serialise from, S.serialise to])
+              MsgClientDone -> ("client-done", [])
+              MsgStartBatch -> ("start-batch", [])
+              MsgNoBlocks -> ("no-blocks", [])
+              MsgBlock block -> ("block", [S.serialise block])
+              MsgBatchDone -> ("batch-done", [])
+        hPutStrLn out $ intercalate "\t" $
+          [ "blockfetch-ordinary-codec-v1", show caseSeed, show ordinal, show caseSize
+          , state, sender, tag, hex (encode ordinary msg)
+          , intercalate "," (map hex fields), show msg
+          ] ++ map (\r -> if isSuccess r then "pass" else "upstream-failure") verdicts
+  where
+    hex = concatMap (pad . (`showHex` "")) . BS.unpack . BL.toStrict
+    pad [digit] = ['0', digit]
+    pad digits = digits
